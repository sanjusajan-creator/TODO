{
  "framework": "vite",
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/auth", "dest": "/api/index.js", "methods": ["POST"] },
    { "src": "/api/tasks", "dest": "/api/index.js", "methods": ["GET", "POST"] },
    { "src": "/api/tasks/.*", "dest": "/api/index.js", "methods": ["PUT", "DELETE"] }
  ]
}